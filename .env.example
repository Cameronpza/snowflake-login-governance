SNOWFLAKE_ACCOUNT=your_account_locator.region.cloud
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password_here

# Optional. Warehouse to run queries with (required for SNOWFLAKE.ACCOUNT_USAGE
# queries, e.g. LOGIN_HISTORY, since those need an active warehouse).
SNOWFLAKE_WAREHOUSE=COMPUTE_WH

# Optional. Role to connect as, if different from the user's default role.
# For CLAUDE_SERVICE_USER this should be LOGIN_GOVERNANCE_READER (minimal,
# read-only role created by setup_service_role.py) rather than ACCOUNTADMIN.
SNOWFLAKE_ROLE=LOGIN_GOVERNANCE_READER
